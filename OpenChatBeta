-- CRIAR OU OBTER ABA PRIVADA DE UM JOGADOR
criarAbaPrivada = function(targetUsername)
    if abasPrivadas[targetUsername] then
        return abasPrivadas[targetUsername]
    end

    -- Frame do Histórico Privado
    local historyFrame = Instance.new("ScrollingFrame")
    historyFrame.Name = "PV_" .. targetUsername
    historyFrame.Size = UDim2.new(1, -24, 1, -120)
    historyFrame.Position = UDim2.new(0, 12, 0, 68)
    historyFrame.BackgroundTransparency = 1
    historyFrame.ScrollBarThickness = 3
    historyFrame.ScrollBarImageColor3 = Color3.fromRGB(120, 120, 120)
    historyFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    historyFrame.ZIndex = 6
    historyFrame.Visible = false
    historyFrame.Parent = G2L.Main

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = historyFrame

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        historyFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    -- Botão da Aba na TabBar
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_PV_" .. targetUsername
    tabBtn.Size = UDim2.new(0, 95, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(55, 45, 25)
    tabBtn.Text = "@" .. targetUsername
    tabBtn.Font = FONTE_PIXEL
    tabBtn.TextColor3 = Color3.fromRGB(255, 200, 80)
    tabBtn.TextSize = 11
    tabBtn.LayoutOrder = 10
    tabBtn.ZIndex = 7
    tabBtn.Parent = G2L.TabBar

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 4)
    tabCorner.Parent = tabBtn

    local tabCloseBtn = Instance.new("ImageButton")
    tabCloseBtn.Size = UDim2.new(0, 12, 0, 12)
    tabCloseBtn.Position = UDim2.new(1, -15, 0.5, -6)
    tabCloseBtn.BackgroundTransparency = 1
    tabCloseBtn.Image = ID_BOTAO_FECHAR
    tabCloseBtn.ZIndex = 8
    tabCloseBtn.Parent = tabBtn

    tabBtn.MouseButton1Click:Connect(function()
        SelecionarAba(targetUsername)
    end)

    tabCloseBtn.MouseButton1Click:Connect(function()
        tabBtn.Visible = false
        historyFrame.Visible = false
        if abaAtual == targetUsername then
            SelecionarAba(modoGlobal and "GLOBAL" or "SERVER")
        end
    end)

    abasPrivadas[targetUsername] = {
        HistoryFrame = historyFrame,
        TabBtn = tabBtn,
        UnreadCount = 0,
        Layout = layout
    }

    return abasPrivadas[targetUsername]
end

-- DISPARAR AVISO TOAST DE MENSAGEM PRIVADA
local function DispararToast(senderUsername, message)
    ToastText.Text = string.format("<font color='rgb(255,200,50)'>@%s:</font> %s", senderUsername, message)
    ToastText.RichText = true
    ToastFrame.Visible = true
    ToastFrame.Position = UDim2.new(0.05, 0, 0, 5)

    if toastTimerThread then task.cancel(toastTimerThread) end

    ToastGoBtn.MouseButton1Click:Connect(function()
        OcultarToast()
        local data = criarAbaPrivada(senderUsername)
        data.TabBtn.Visible = true
        SelecionarAba(senderUsername)
    end)

    toastTimerThread = task.delay(5, function()
        OcultarToast()
    end)
end

