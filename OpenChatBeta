-- CONTROLE DAS ABAS
local function OcultarTodasAsAbas()
    G2L.ServerHistory.Visible = false
    G2L.GlobalHistory.Visible = false
    for _, data in pairs(abasPrivadas) do
        if data.HistoryFrame then
            data.HistoryFrame.Visible = false
        end
    end
end

local criarAbaPrivada -- Declaração antecipada

local function SelecionarAba(nomeAba)
    OcultarTodasAsAbas()
    abaAtual = nomeAba

    if nomeAba == "SERVER" then
        modoGlobal = false
        destinatarioPrivado = nil
        G2L.Title.Text = "CHAT SERVIDOR SPWNCUB"
        G2L.ServerHistory.Visible = true
    elseif nomeAba == "GLOBAL" then
        modoGlobal = true
        destinatarioPrivado = nil
        G2L.Title.Text = "CHAT GLOBAL SPWNCUB"
        G2L.GlobalHistory.Visible = true
    else
        destinatarioPrivado = nomeAba
        G2L.Title.Text = "PV: @" .. string.upper(nomeAba)
        if abasPrivadas[nomeAba] then
            abasPrivadas[nomeAba].UnreadCount = 0
            abasPrivadas[nomeAba].TabBtn.Text = "@" .. nomeAba
            abasPrivadas[nomeAba].HistoryFrame.Visible = true
        end
    end
end

