-- BUBBLE CHAT
local function MostrarBubbleChat(username, message)
    local targetPlayer = Players:FindFirstChild(username)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
        ChatService:Chat(targetPlayer.Character.Head, message, Enum.ChatColor.White)
    end
end

-- ADICIONAR MENSAGEM NO HISTÓRICO CORRETO
local function AdicionarMensagem(username, displayname, msg, isMe, isPrivate, mode)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -5, 0, 18)
    btn.BackgroundTransparency = 1
    btn.RichText = true
    btn.Font = FONTE_MENSAGENS
    btn.TextSize = 15
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false

    local prefix = ""
    if isPrivate then
        prefix = "<font color='rgb(255,200,50)'>[PV]</font> "
    elseif mode == "GLOBAL" then
        prefix = "<font color='rgb(100,200,255)'>[GLOBAL]</font> "
    end

    local nameColor = isMe and "rgb(255,110,110)" or "rgb(180,130,255)"
    btn.Text = string.format("%s<font color='%s'>%s:</font> <font color='rgb(240,240,240)'>%s</font>", prefix, nameColor, displayname, msg)

    btn.AutomaticSize = Enum.AutomaticSize.Y
    btn.TextWrapped = true
    btn.ZIndex = 6

    -- DEFINIR EM QUAL ABA A MENSAGEM FICARÁ
    local targetHistoryContainer = G2L.ServerHistory
    if mode == "GLOBAL" and not isPrivate then
        targetHistoryContainer = G2L.GlobalHistory
    end
    btn.Parent = targetHistoryContainer

    -- MENSAGEM DIRETA
    btn.MouseButton1Click:Connect(function()
        if not modoSelecaoAtivo and username ~= Player.Name then
            destinatarioPrivado = username
            TargetText.Text = "Mensagem Direta para: @" .. username
            TargetIndicator.Visible = true
        end
    end)

    -- COPIAR (MODO SELEÇÃO)
    local pressTimer
    local isHolding = false

    btn.InputBegan:Connect(function(input)
        if modoSelecaoAtivo and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            isHolding = true
            pressTimer = task.delay(0.5, function()
                if isHolding and modoSelecaoAtivo then
                    if setclipboard then
                        setclipboard(msg)
                    elseif toclipboard then
                        toclipboard(msg)
                    end
                end
            end)
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isHolding = false
            if pressTimer then task.cancel(pressTimer) end
        end
    end)

    targetHistoryContainer.CanvasPosition = Vector2.new(0, targetHistoryContainer.UIListLayout.AbsoluteContentSize.Y)

    if not G2L.Main.Visible and not isMe then
        G2L.ToggleButton.Image = ID_NOTIFICACAO
        NotificationSound:Play()
    end

    MostrarBubbleChat(username, msg)
end

-- CONEXÃO E FILTRAGEM WEBSOCKET
local socket
local running = true

local function ConnectWebSocket()
    if not running then return end

    local success, res = pcall(function()
        return WebSocket.connect(wsUrl)
    end)

    if success and res then
        socket = res
        print("SpwnCub Chat Conectado com Sucesso!")

        socket.OnMessage:Connect(function(msg)
            if not running then return end
            local ok, data = pcall(function() return HttpService:JSONDecode(msg) end)
            
            if ok and data.message then
                local isMe = (data.username == Player.Name)
                local isPrivate = (data.target ~= nil and data.target ~= "")

                -- 1. SE FOR MENSAGEM PRIVADA PARA PESSOA ESPECÍFICA
                if isPrivate then
                    if data.target ~= Player.Name and not isMe then 
                        return -- Não é para você -> Ignora
                    end
                
                -- 2. SE FOR MENSAGEM DE SERVIDOR (LOCAL)
                elseif data.mode == "SERVER" then
                    if data.serverId ~= CURRENT_SERVER_ID then 
                        return -- Pertence a outro servidor -> Ignora
                    end
                end

                local dName = data.nickname or data.username
                AdicionarMensagem(data.username, dName, data.message, isMe, isPrivate, data.mode)
            end
        end)

        socket.OnClose:Connect(function()
            if running then
                warn("Conexão encerrada. Reconectando em 5s...")
                task.wait(5)
                ConnectWebSocket()
            end
        end)
    else
        if running then
            warn("Erro de conexão. Reconectando em 5s...")
            task.wait(5)
            ConnectWebSocket()
        end
    end
end

-- ENVIAR MENSAGEM
local function EnviarMensagem()
    if socket and G2L.Input.Text ~= "" then
        local modoEnvio = modoGlobal and "GLOBAL" or "SERVER"

        local payload = {
            username = Player.Name, 
            nickname = Player.DisplayName, 
            message = G2L.Input.Text,
            mode = modoEnvio,
            serverId = CURRENT_SERVER_ID,
            target = destinatarioPrivado
        }

        local success, err = pcall(function()
            socket:Send(HttpService:JSONEncode(payload))
        end)

        if not success then 
            warn("Falha no envio. Tentando reconectar...")
            ConnectWebSocket()
        end

        G2L.Input.Text = ""
    end
end

G2L.SendBtn.MouseButton1Click:Connect(EnviarMensagem)
G2L.Input.FocusLost:Connect(function(enter) if enter then EnviarMensagem() end end)

-- FUNÇÃO DE ARRASTE (DRAG)
local function MakeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

