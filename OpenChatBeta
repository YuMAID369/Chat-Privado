-- CRIAR/OBTER ABA DE CHAT PRIVADO COM UM JOGADOR
local function AbrirAbaPrivada(targetUsername)
    destinatarioPrivado = targetUsername
    TargetText.Text = "Mensagem Direta para: @" .. targetUsername
    TargetIndicator.Visible = true

    OcultarTodasAsAbas()
    abaAtual = targetUsername
    G2L.Title.Text = "PV: @" .. string.upper(targetUsername)

    if not abasPrivadas[targetUsername] then
        -- Cria novo Frame de histórico dedicado
        local historyFrame = Instance.new("ScrollingFrame")
        historyFrame.Name = "PV_" .. targetUsername
        historyFrame.Size = UDim2.new(1, -24, 1, -100)
        historyFrame.Position = UDim2.new(0, 12, 0, 44)
        historyFrame.BackgroundTransparency = 1
        historyFrame.ScrollBarThickness = 3
        historyFrame.ScrollBarImageColor3 = Color3.fromRGB(120, 120, 120)
        historyFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
        historyFrame.ZIndex = 6
        historyFrame.Visible = true
        historyFrame.Parent = G2L.Main

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 3)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = historyFrame

        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            historyFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end)

        abasPrivadas[targetUsername] = {
            HistoryFrame = historyFrame,
            Layout = layout
        }
    else
        -- Reabre a aba existente sem apagar mensagens passadas
        abasPrivadas[targetUsername].HistoryFrame.Visible = true
    end
end

